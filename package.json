{
  "name": "akamai-sandbox-cli",
  "version": "1.8.3",
  "description": "A tool that makes it easier to manage Akamai Sandboxes. Call the Sandbox API from the command line.",
  "repository": "https://github.com/akamai/cli-sandbox",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "npm run clean && npm run build-ts && npm run copy-json",
    "clean": "node scripts/build-utils.mjs clean ./bin",
    "build-ts": "tsc",
    "copy-json": "node scripts/build-utils.mjs copy schemas src/template package.json ./bin",
    "postinstall": "npm run build"
  },
  "bin": {
    "sandbox": "./akamai-sandbox.js"
  },
  "engines": {
    "node": ">=20 <=24",
    "npm": ">=9 <=11"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "akamai-edgegrid": "3.5.4",
    "app-root-path": "3.1.0",
    "cli-spinner": "0.2.10",
    "commander": "4.1.1",
    "easy-table": "1.2.0",
    "find-java-home": "2.0.0",
    "fs-extra": "^11.4.1",
    "glob": "^11.1.0",
    "got": "^14.6.6",
    "inquirer": "^12.11.1",
    "jsonschema": "1.5.0",
    "jwt-decode": "4.0.0",
    "lodash": "^4.18.1",
    "semver": "^7.8.5",
    "untildify": "5.0.0",
    "uuid": "^11.1.1",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/lodash": "^4.17.27",
    "@types/node": "22.14.0",
    "@types/request": "^2.48.13",
    "typescript": "5.8.3"
  },
  "overrides": {
    "form-data": "^4.0.4",
    "execa": "^9.5.2"
  }
}
